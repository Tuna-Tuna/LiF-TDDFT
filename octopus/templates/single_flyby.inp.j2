# Revision run {{ run_id }}
# F-/LiF(100), fixed target with a prescribed constant-velocity projectile
# cluster_model={{ cluster_model }}, variant={{ variant }}
FromScratch = {{ from_scratch }}
ExperimentalFeatures = yes
CalculationMode = {{ calculation_mode }}
UnitsOutput = eV_Angstrom
ParStates = auto
ParDomains = {{ mpi_ranks }}
PoissonSolver = isf
Radius = {{ box_radius_angstrom }}*angstrom
BoxShape = sphere
Spacing = {{ grid_spacing_angstrom }}*angstrom
MoveIons = {{ move_ions }}
IonsConstantVelocity = {{ ions_constant_velocity }}
TDDynamics = ehrenfest

Ha = 3.7958
%Species
 "Li"   | species_pseudo       | file | "./{{ lithium_pseudopotential }}"
 "F"    | species_pseudo       | file | "./{{ fluorine_pseudopotential }}"
 "udfF" | species_user_defined | potential_formula | "1/r*erf(0.566*r)" | valence | 0
%

zcoor = 0
height = {{ height_bohr }}
%Coordinates
 "F"    | {{ projectile_x_bohr }} |  0*Ha | height+zcoor | yes
 "Li"   | 1*Ha  |  0*Ha | 0+zcoor       | no
 "udfF" | 1*Ha  |  1*Ha | 0+zcoor       | no
 "udfF" | 1*Ha  | -1*Ha | 0+zcoor       | no
 "F"    | 0*Ha |  0*Ha | 0+zcoor       | no
 "Li"   | 0*Ha |  1*Ha | 0+zcoor       | no
 "Li"   | 0*Ha | -1*Ha | 0+zcoor       | no
 "Li"   | -1*Ha |  0*Ha | 0+zcoor       | no
 "udfF" | -1*Ha |  1*Ha | 0+zcoor       | no
 "udfF" | -1*Ha | -1*Ha | 0+zcoor       | no
 "F"    | 1*Ha  |  0*Ha | -1*Ha+zcoor   | no
 "Li"   | 1*Ha  |  1*Ha | -1*Ha+zcoor   | no
 "Li"   | 1*Ha  | -1*Ha | -1*Ha+zcoor   | no
 "Li"   | 0*Ha |  0*Ha | -1*Ha+zcoor   | no
 "F"    | 0*Ha |  1*Ha | -1*Ha+zcoor   | no
 "F"    | 0*Ha | -1*Ha | -1*Ha+zcoor   | no
 "F"    | -1*Ha |  0*Ha | -1*Ha+zcoor   | no
 "Li"   | -1*Ha |  1*Ha | -1*Ha+zcoor   | no
 "Li"   | -1*Ha | -1*Ha | -1*Ha+zcoor   | no
%

Fv = {{ relative_velocity_au }}
%Velocities
 "F"    | {{ projectile_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "udfF" | {{ cluster_velocity_au }} | 0 | 0
 "udfF" | {{ cluster_velocity_au }} | 0 | 0
 "F"    | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "udfF" | {{ cluster_velocity_au }} | 0 | 0
 "udfF" | {{ cluster_velocity_au }} | 0 | 0
 "F"    | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "F"    | {{ cluster_velocity_au }} | 0 | 0
 "F"    | {{ cluster_velocity_au }} | 0 | 0
 "F"    | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
 "Li"   | {{ cluster_velocity_au }} | 0 | 0
%

ExcessCharge = -1
AbsorbingBoundaries = cap
ABCapHeight = {{ cap_strength }}
%ABShape
 {{ cap_start_angstrom }}*angstrom | {{ cap_end_angstrom }}*angstrom | "r"
%
%Output
{% for item in spatial_outputs %} {{ item }}
{% endfor %}%
OutputFormat = netcdf
OutputInterval = {{ output_interval }}
XCFunctional = {{ xc_functional }}
TDPropagator = etrs
dt = {{ time_step_expression }}
TDTimeStep = dt
TDPropagationTime = {{ propagation_time_expression }}
%TDOutput
{% for item in td_outputs %} {{ item }}
{% endfor %}%
